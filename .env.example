# Copy to .env and adjust as needed. All backend settings are optional —
# see backend/app/core/config.py for defaults.

# Path to the YOLOv8 weights (defaults to models/yolov8_model.pt, the
# DVC-tracked checkpoint).
# IDS_MODEL_PATH=models/yolov8_model.pt

# "auto" (default, picks cuda if available), "cpu", or "cuda".
# IDS_DEVICE=auto

# Default detection confidence threshold used by the live-stream endpoint.
# IDS_DEFAULT_CONFIDENCE_THRESHOLD=0.4

# JSON array of allowed frontend origins for CORS.
# IDS_CORS_ORIGINS=["http://localhost:5173"]

# Max video upload size in MB, rejected mid-stream (413) if exceeded.
# IDS_MAX_UPLOAD_MB=500
